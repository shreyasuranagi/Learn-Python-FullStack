   "source": [
    "#decorators\n",
    "\n",
    "def instagram(func):\n",
    "    def wrapper(*args,**kwargs):\n",
    "        print('login')\n",
    "        func(*args,**kwargs)\n",
    "        print('logout')\n",
    "    return wrapper \n",
    "\n",
    "@instagram\n",
    "def shreya(name):\n",
    "    print('shreya text with ',name)\n",
    "\n",
    "\n",
    "shreya('nandhika')"
   ]
  }
 ],
