SQL> --5 WAQTD NUMBER OF EMPLOYEES WORKING AS CLERK OR MANAGER
SQL> SELECT COUNT(*)
  2  FROM EMP
  3  WHERE JOB='CLERK' OR JOB='MANAGER';

  COUNT(*)                                                                                          
----------                                                                                          
         7                                                                                          

SQL> -- 6 WAQTD TOTAL SALARY NEEDED TO PAY EMPLOYEES HIRED IN FEB.
SQL> SELECT SUM(SAL)
  2  FROM EMP
  3  WHERE HIREDATE LIKE '%FEB%';

  SUM(SAL)                                                                                          
----------                                                                                          
      2850                                                                                          

SQL> --7 WAQTD NUMBER OF EMPLOYEES REPORTING TO 7839 (MGR)
SQL> SELECT COUNT(*)
  2  FROM EMP
  3  WHERE MGR=7839;

  COUNT(*)                                                                                          
----------                                                                                          
