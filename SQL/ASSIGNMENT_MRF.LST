SQL> --1 1. WAQTD NUMBER OF EMPLOYEES GETTING SALARY LESS THAN 2000 IN DEPTNO 10
SQL> SELECT COUNT * FROM EMP WHERE SAL<2000 AND DEPTNO IN 10;
SELECT COUNT * FROM EMP WHERE SAL<2000 AND DEPTNO IN 10
               *
ERROR at line 1:
ORA-00936: missing expression 


SQL> SELECT COUNT *
  2  FROM EMP
  3  WHERE SAL<2000 AND DEPTNO IN 10;
FROM EMP
*
ERROR at line 2:
ORA-00936: missing expression 


SQL> SELECT COUNT(*)
  2  FROM EMP
  3  WHERE SAL<2000 AND DEPTNO IN 10;

  COUNT(*)                                                                                          
----------                                                                                          
         1                                                                                          

SQL> SELECT COUNT(ENAME)
  2  FROM EMP
  3  WHERE SAL<2000 AND DEPTNO IN 10;

COUNT(ENAME)                                                                                        
------------                                                                                        
           1                                                                                        

SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE COUNT(WHERE SAL<2000 AND DEPTNO IN 10)>0;
WHERE COUNT(WHERE SAL<2000 AND DEPTNO IN 10)>0
      *
ERROR at line 3:
ORA-00934: group function is not allowed here 


SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE COUNT(SAL<2000 AND DEPTNO IN 10);
WHERE COUNT(SAL<2000 AND DEPTNO IN 10)
      *
ERROR at line 3:
ORA-00934: group function is not allowed here 


SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE MAX(COUNT(ENAME))>0;
WHERE MAX(COUNT(ENAME))>0
      *
ERROR at line 3:
ORA-00934: group function is not allowed here 


SQL> --2 WAQTD TOTAL SALARY NEEDED TO PAY EMPLOYEES WORKING AS CLERK
SQL> SELECT SUM(SAL)
  2  FROM EMP
  3  WHERE JOB='CLERK';

  SUM(SAL)                                                                                          
----------                                                                                          
      4150                                                                                          

SQL> --3 WAQTD AVERAGE SALARY NEEDED TO PAY ALL EMPLOYEES.
SQL> SELECT AVG(SAL)
  2  FROM EMP
  3  ;

  AVG(SAL)                                                                                          
----------                                                                                          
2073.21429                                                                                          

SQL> SELEC AVG(SAL) AVG_SAL
SP2-0734: unknown command beginning "SELEC AVG(..." - rest of line ignored.
SQL> SELECT AVG(SAL) AVG_SAL
  2  FROM EMP;

   AVG_SAL                                                                                          
----------                                                                                          
2073.21429                                                                                          

SQL> --4 WAQTD NUMBER OF EMPLOYEES HAVING 'A' AS THEIR FIRST CHARACTER.
SQL> SELECT COUNT(*)
  2  FROM EMP
  3  WHERE ENAME LIKE 'A%';

  COUNT(*)                                                                                          
----------                                                                                          
         2                                                                                          

SQL> SELECT EMP.COUNT(*), ENAME
  2  FROM EMP
  3  WHERE ENAME LIKE 'A%';
SELECT EMP.COUNT(*), ENAME
