SQL> --List the number of employee in each department, except 30, sorted high to low. Only include department with 3 or more employee.
SQL> SELECT COUNT(*), DEPTNO
  2  FROM EMP
  3  WHERE DEPTNO<>30
  4  GROUP BY DEPTNO
  5  HAVING COUNT(*)>=3
  6  ORDER BY COUNT(*) DESC;

  COUNT(*)     DEPTNO                                                                                                                                                                                   
---------- ----------                                                                                                                                                                                   
         5         20                                                                                                                                                                                   
         3         10                                                                                                                                                                                   

