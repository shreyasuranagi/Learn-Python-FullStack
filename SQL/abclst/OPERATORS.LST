SQL> --Display the deptno which is having the maximum salary and maximum salary more than 1500 earned by the employee and job description not as a clerk and sort by descending order
SQL> SELECT
  2  DEPTNO
  3  FROM EMP
  4  WHERE JOB<>'CLERK'
  5  GROUP BY MAX(SAL), MIN(SAL)
  6  ORDER BY SAL DESC;
GROUP BY MAX(SAL), MIN(SAL)
         *
