SQL> --2
SQL> --WAQTD EMP NAME HIS DNAME AND MGR DEISGNATION AND HIS LOCATION IF MGR WORKS IN DEPT 10 OR DEPT 20
SQL> SELECT E.ENAME, ED.DNAME, M.ENAME, MD.DNAME
  2  FROM EMP E, EMP M, DEPT D, DEPT MD
  3  WHERE E.MGR=M.EMPNO
  4  	AND D.DEPTNO=E.DEPTNO
  5  	AND M.DEPTNO=MD.DEPTNO
  6  	AND M.DEPTNO IN (10,20);
SELECT E.ENAME, ED.DNAME, M.ENAME, MD.DNAME
                *
