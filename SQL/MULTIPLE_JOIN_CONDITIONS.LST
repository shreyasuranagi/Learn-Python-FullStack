SQL> --3
SQL> --WAQTD EMP NAME AND MANAGERS SALARY ALONG WITH MANAGERS MANAGER HIREDATE IF MANAGERS AMNAGER EARN MORE THAN 2300
SQL> SELECT E.ENAME, M.SAL, MM.HIREDATE
  2  FROM EMP E, EMP M, EMP MM
  3  WHERE E.MGR=M.EMPNO
  4  	AND M.MGR=MM.EMPNO
  5  	AND MM.SAL>2300;

