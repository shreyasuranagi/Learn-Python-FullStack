SQL> --WAQTD EMP NAME AND MANAGERS HIREDATE IF EMMPLOYEE WAS HIRED BEFORE 1982 AND MANAGERS MANAGER IS NOT EARNING ANY COMMISSION
SQL> SELECT E.ENAME, M.HIREDATE
  2  FROM EMP E, EMP M
  3  WHERE E.HIREDATE<'01-JAN-82' AND M;
WHERE E.HIREDATE<'01-JAN-82' AND M
