SQL> SELECT E.ENAME, M.ENAME, MM.ENAME
  2  FROM EMP E, EMP M, EMP MM
  3  WHERE E.JOB='CLERK' AND E.MGR=M.EMPNO AND M.MGR=MM.EMPNO;

