Wrote file afiedt.buf

  1  SELECT DEPTNO, COUNT(*)
  2  FROM EMP
  3  WHERE JOB IN ('CLERK','SALESMAN','ANALYST')
  4  GROUP BY DEPTNO
  5  HAVING COUNT(*)>=2
  6* ORDER BY DEPTNO DESC
SQL> /

    DEPTNO   COUNT(*)                                                                               
---------- ----------                                                                               
        30          5                                                                               
        20          4                                                                               

