SQL> SELECT DEPTNO, COUNT(*)
  2  FROM EMP
  3  WHERE JOB IN ('CLERK','SALESMAN','ANALYST')
  4  GROUP BY DEPTNO
  5  HAVING COUNT(*)>=2
  6  ORDER BY DEPTNO;

    DEPTNO   COUNT(*)                                                                               
---------- ----------                                                                               
        20          4                                                                               
        30          5                                                                               

