SQL> --7 WAQTD DETAILS OF THE EMPLOYEE WHO HAS GREATEST EMPNO.
SQL> SELECT *
  2  FROM EMP
  3  WHERE EMPNO = (SELECT MAX(EMPNO)
  4  			FROM EMP);

