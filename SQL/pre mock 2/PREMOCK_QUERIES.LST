SQL> --Q4)WAQTD hiredate who hired 2,4,5 and last hired employee.
SQL> 
SQL> SELECT E1.HIREDATE
  2  FROM EMP E1
  3  WHERE (SELECT COUNT(DISTINCT E2.HIREDATE)
  4  		FROM EMP E2
  5  		WHERE E1.HIREDATE>E2.HIREDATE) IN (1,3,4)
  6  OR E1.HIREDATE = (SELECT MIN(E1.HIREDATE)
  7  			FROM EMP E1);

HIREDATE                                                                                                                                                                                                
---------                                                                                                                                                                                               
17-DEC-80                                                                                                                                                                                               
20-FEB-81                                                                                                                                                                                               
02-APR-81                                                                                                                                                                                               
01-MAY-81                                                                                                                                                                                               

