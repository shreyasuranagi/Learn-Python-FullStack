SQL> --Q3) waqtd employees names, managers names, department name if managers are working as salesman, clerk, and earning exactly 4 digits, and employees department should consists of a,s,o,r in location of new york, boston,chicago, and arrange the salaries in descending order
SQL> 
SQL> SELECT E.ENAME, M.ENAME, D.DNAME
  2  FROM EMP E, EMP M, DEPT D
  3  WHERE E.DEPTNO = D.DEPTNO
  4  AND E.MGR=M.EMPNO
  5  AND D.DNAME IN ('NEW YORK', 'BOSTON', 'CHICAGO')
  6  AND M.JOB IN ('SALESMAN','CLERK')
  7  AND M.SAL LIKE '____'
  8  ORDER BY E.SAL DESC;

no rows selected

