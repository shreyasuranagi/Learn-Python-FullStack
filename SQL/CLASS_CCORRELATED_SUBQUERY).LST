SQL> --WAQTD 4TH MAXIMUM SALARY
SQL> SELECT E1.SAL
  2  FROM EMP E1
  3  WHERE E1.SAL IN (SELECT COUNT(DISTINCT(E2.SAL))
  4  		FROM EMP E2
  5  		WHERE E1.SAL<E2.SAL);

